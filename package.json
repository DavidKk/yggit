{
  "name": "yggdrasil",
  "version": "0.0.2",
  "private": true,
  "description": "Yggit - World Tree Git graph and repository management tool",
  "author": "DavidJones",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidKk/yggit.git"
  },
  "homepage": "https://github.com/DavidKk/yggit",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:loopback": "node scripts/dev.mjs --loopback",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "start:lan": "node scripts/start.mjs --lan",
    "start:loopback": "node scripts/start.mjs --loopback",
    "prepare": "husky",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "fix:imports": "node scripts/fix-missing-imports.mjs",
    "format": "prettier --config .prettierrc.cjs --write \"**/*.{js,jsx,cjs,ts,tsx,md,json,yml,yaml,mjs,css}\"",
    "format:check": "prettier --config .prettierrc.cjs --check \"**/*.{js,jsx,cjs,ts,tsx,md,json,yml,yaml,mjs,css}\"",
    "lint": "eslint -c eslint.config.mjs --fix --max-warnings=0 .",
    "lint:check": "eslint -c eslint.config.mjs --max-warnings=0 .",
    "ok": "pnpm fix:imports && pnpm format && pnpm lint && pnpm typecheck && pnpm exec jest --runInBand && pnpm build",
    "ok:full": "pnpm ok",
    "ok:ci": "pnpm format:check && pnpm lint:check && pnpm typecheck && pnpm exec jest --runInBand && pnpm build",
    "translate": "tsx services/translate/cli.ts",
    "translate:resources": "tsx services/translate/resources/cli.ts",
    "updates": "tsx services/updates/cli.ts",
    "updates:prepare": "tsx services/updates/release-cli.ts",
    "extract": "tsx services/extract/cli.ts",
    "translate:import-cache": "tsx services/translate/import-cache.ts",
    "build:translate": "node services/translate/build.mjs",
    "build:translate:dev": "node services/translate/build.mjs --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@lydell/node-pty": "1.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@vercel/analytics": "^2.0.1",
    "bing-translate-api": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "diff": "8.0.4",
    "drizzle-orm": "1.0.0-rc.4",
    "eruda": "^3.4.3",
    "fflate": "^0.8.3",
    "isomorphic-git": "^1.44.13",
    "kuromoji": "^0.1.2",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.57.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "shiki": "^4.5.0",
    "socks": "^2.8",
    "tuf-js": "4.1.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7",
    "wordguard": "^0.1.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@jest/globals": "^30.5.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "commitlint-plugin-i18n": "^0.0.1-alpha.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "30",
    "lint-staged": "^15.2.7",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^6"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=22.19.0"
  }
}
